rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasUserDocument() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return hasUserDocument()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active
          == true;
    }

    function isTrainingManager() {
      return isSignedIn()
        && hasUserDocument()
        && isActiveUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          == "trainingManager";
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isTrainingManager();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          "name",
          "email",
          "photoURL",
          "role",
          "active",
          "createdAt"
        ])
        && request.resource.data.role == "instructor"
        && request.resource.data.active == true;

      // The current app creates profile fields once and does not provide an
      // instructor profile editor. Only managers may update user documents.
      allow update: if isTrainingManager();

      allow delete: if isTrainingManager();
    }

    // Legacy collection used until the explicit units migration in Phase 3.
    match /topics/{topicId} {
      allow read: if isTrainingManager()
        || (isActiveUser() && resource.data.active == true);
      allow write: if isTrainingManager();
    }

    match /units/{unitId} {
      allow read: if isTrainingManager()
        || (isActiveUser() && resource.data.status == "published");
      allow write: if isTrainingManager();

      match /steps/{stepId} {
        allow read: if isTrainingManager()
          || (isActiveUser()
            && get(/databases/$(database)/documents/units/$(unitId)).data.status
              == "published"
            && resource.data.status == "published");
        allow write: if isTrainingManager();
      }
    }

    match /progress/{uid} {
      allow read: if (isOwner(uid) && isActiveUser()) || isTrainingManager();
      allow create, update: if isOwner(uid) && isActiveUser();
    }

    // These collections are manager-only until their learner-facing schemas are
    // implemented in Phases 7 and 8.
    match /questions/{questionId} {
      allow read, write: if isTrainingManager();
    }

    match /simulations/{simulationId} {
      allow read, write: if isTrainingManager();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
